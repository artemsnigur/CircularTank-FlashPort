#!/bin/sh
# Fast gate. Anything slower than a few seconds belongs in pre-push.
#
# Timings that set this split (measured 2026-07-27):
#   typecheck 2.8s | lint 5.2s | test 6.8s | data:check 3.0s
# Lint sits in pre-push despite catching real defects — two eslint errors were
# committed this session — because an 8s commit gate gets bypassed with
# --no-verify, and a guarantee enforced by patience is not enforced.
#
# Hooks run from the repo root; the npm project is NewVersion/.

set -e

# ── 0. This hook must match the committed source ─────────────────────────
# `install-hooks.mjs` *copies* into .git/hooks, so the running copy can drift
# from the version-controlled one. `prepare` covers npm install; it does not
# cover a branch switch or a pull that changes a hook. Without this check,
# "the installed hooks match the committed ones" would be enforced by
# remembering to reinstall — the same asserted-guarantee shape these hooks
# exist to replace.
#
# Compares against the source **in this working tree**, not against HEAD.
# Against HEAD it would block the very commit that updates a hook, since the
# installed copy is by then already newer than the committed one. Working-tree
# comparison gives the property actually wanted: the gate that runs is the gate
# this checkout describes. Edit a hook and reinstall and it passes; switch
# branch or pull a hook change without reinstalling and it does not.
#
# Skips silently when the source is absent — a branch without .husky/, e.g.
# main. The guards below still run there, which is the whole reason these are
# installed outside the working tree.
hook_self="$(git rev-parse --git-path hooks/pre-commit)"
hook_source="NewVersion/.husky/pre-commit"
if [ -f "$hook_source" ]; then
  if [ "$(git hash-object "$hook_self")" != "$(git hash-object "$hook_source")" ]; then
    echo "pre-commit: the installed hook does not match $hook_source."
    echo "            Refusing to run a stale gate — reinstall with:"
    echo "              cd NewVersion && npm run prepare"
    exit 1
  fi
fi

# ── 1. Never commit on main ──────────────────────────────────────────────
branch="$(git rev-parse --abbrev-ref HEAD)"
if [ "$branch" = "main" ]; then
  echo "pre-commit: refusing to commit on main. Work happens on develop."
  echo "            git switch develop   (or git checkout -b <branch>)"
  exit 1
fi

# ── 2. SWFimported/ is read-only ─────────────────────────────────────────
# It is the JPEXS extraction and the source being ported from. The leading
# number on each file is the SWF library ID and the only link back to
# symbolClass/symbols.csv, so a rename severs provenance silently.
staged_swf="$(git diff --cached --name-only --diff-filter=ACMRD | grep '^SWFimported/' || true)"
if [ -n "$staged_swf" ]; then
  echo "pre-commit: SWFimported/ is read-only. Staged changes to:"
  echo "$staged_swf" | sed 's/^/  /'
  echo "            git restore --staged SWFimported/"
  exit 1
fi

# ── 3. Typecheck ─────────────────────────────────────────────────────────
cd NewVersion
npm run typecheck
