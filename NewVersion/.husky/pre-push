#!/bin/sh
# Slow gate — everything that must be true before code leaves this machine.
#
# ~15s total (lint 5.2s, tests 6.8s, data:check 3.0s). Deliberately here rather
# than in pre-commit: a gate slow enough to be annoying is a gate that gets
# --no-verify'd, and then it enforces nothing.
#
# data:check is included because six generated files and PROGRESS.md can go
# stale without any test failing — the generators are the mechanism, and this
# is what makes them one.

set -e

# ── 0. This hook must match the committed source ─────────────────────────
# Same drift check as pre-commit, and arguably more important here: this is the
# gate carrying lint, the full suite and data:check, so a stale copy of *this*
# file is the more expensive silence. Compared against the working tree, not
# HEAD — see the note in pre-commit for why.
hook_self="$(git rev-parse --git-path hooks/pre-push)"
hook_source="NewVersion/.husky/pre-push"
if [ -f "$hook_source" ]; then
  if [ "$(git hash-object "$hook_self")" != "$(git hash-object "$hook_source")" ]; then
    echo "pre-push: the installed hook does not match $hook_source."
    echo "          Refusing to run a stale gate — reinstall with:"
    echo "            cd NewVersion && npm run prepare"
    exit 1
  fi
fi

cd NewVersion
npm run lint
npm test
npm run data:check
