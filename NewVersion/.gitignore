node_modules/
dist/
dist-ssr/
.vite/
coverage/
*.local

# Capacitor native projects (generated by `npx cap add`)
android/
ios/

# Generated by `npm run audio:audit --json`
audio-audit.json

# Claude Code session transcript exports (`/export`), which land in the project
# root. Matched by location rather than by name: `/export <name>` takes an
# arbitrary name, so the root rule `*-local-command-caveat*.txt` only ever
# caught the default-named ones and three exports have been staged or committed
# past it anyway. Leading slash keeps this to this directory, so a `.txt`
# fixture deeper in the tree is still tracked — there are none today.
/*.txt

# Extracted SWF assets are copied in by `npm run assets:sync` from
# ../SWFimported, which is the source of truth. Committing them would duplicate
# ~12 MB of binaries. Drop these lines if you would rather vendor them.
src/assets/images/
src/assets/audio/
src/assets/shapes/
src/assets/fonts/

.DS_Store
Thumbs.db
*.log
npm-debug.log*
.idea/workspace.xml
.vscode/*
!.vscode/extensions.json

# Frames from `npm run look` — a tool, not a test; never committed.
.look/
