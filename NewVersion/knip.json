{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "vite": false,
  "vitest": false,
  "entry": [
    "src/main.tsx",
    "scripts/*.mjs"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "scripts/**/*.mjs"
  ],
  "ignore": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "src/test/**",
    "src/assets/*Manifest.ts",
    "src/game/**/*Data.ts"
  ],
  "ignoreDependencies": [
    "@capacitor/core",
    "@testing-library/dom",
    "@testing-library/jest-dom",
    "@testing-library/react",
    "@vitejs/plugin-react",
    "husky"
  ],
  "ignoreBinaries": [
    "vite-node"
  ]
}
