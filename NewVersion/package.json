{
  "name": "circle-defense",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Mobile port of a Flash/AS3 wave-defense game (Vite + React + Phaser 3).",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "assets:sync": "node scripts/sync-assets.mjs",
    "assets:sync:all": "node scripts/sync-assets.mjs --all",
    "audio:audit": "node scripts/audit-mp3.mjs",
    "knip": "knip --no-progress",
    "audio:manifest": "node scripts/gen-audio-manifest.mjs",
    "audio:manifest:check": "node scripts/gen-audio-manifest.mjs --check",
    "achievements:data": "node scripts/gen-achievements.mjs",
    "achievements:data:check": "node scripts/gen-achievements.mjs --check",
    "upgrade-previews:data": "node scripts/gen-upgrade-previews.mjs",
    "achievement-art:data": "node scripts/gen-achievement-art.mjs",
    "achievement-art:data:check": "node scripts/gen-achievement-art.mjs --check",
    "level-guide-art:data": "node scripts/gen-level-guide-art.mjs",
    "level-guide-art:data:check": "node scripts/gen-level-guide-art.mjs --check",
    "resistance-icons:data": "node scripts/gen-resistance-icons.mjs",
    "resistance-icons:data:check": "node scripts/gen-resistance-icons.mjs --check",
    "upgrade-descriptions:data": "node scripts/gen-upgrade-descriptions.mjs",
    "upgrade-descriptions:data:check": "node scripts/gen-upgrade-descriptions.mjs --check",
    "upgrade-previews:data:check": "node scripts/gen-upgrade-previews.mjs --check",
    "projectiles:data": "node scripts/gen-projectile-art.mjs",
    "projectiles:data:check": "node scripts/gen-projectile-art.mjs --check",
    "sprites:data": "node scripts/gen-sprite-shapes.mjs",
    "sprite-geometry:data": "node scripts/gen-sprite-geometry.mjs",
    "sprite-geometry:data:check": "node scripts/gen-sprite-geometry.mjs --check",
    "sprites:data:check": "node scripts/gen-sprite-shapes.mjs --check",
    "levels:data": "node scripts/gen-levels.mjs",
    "levels:data:check": "node scripts/gen-levels.mjs --check",
    "upgrades:data": "node scripts/gen-upgrades.mjs",
    "upgrades:data:check": "node scripts/gen-upgrades.mjs --check",
    "bestiary:data": "node scripts/gen-bestiary.mjs",
    "bestiary:data:check": "node scripts/gen-bestiary.mjs --check",
    "enemy-stats:data": "node scripts/gen-enemy-stats.mjs",
    "enemy-stats:data:check": "node scripts/gen-enemy-stats.mjs --check",
    "enemies:doc": "vite-node scripts/gen-enemy-reference.ts",
    "enemies:doc:check": "vite-node scripts/gen-enemy-reference.ts -- --check",
    "data:check": "npm run achievement-art:data:check && npm run level-guide-art:data:check && npm run resistance-icons:data:check && npm run upgrade-descriptions:data:check && npm run upgrade-previews:data:check && npm run sprites:data:check && npm run sprite-geometry:data:check && npm run projectiles:data:check && npm run audio:manifest:check && npm run achievements:data:check && npm run levels:data:check && npm run upgrades:data:check && npm run bestiary:data:check && npm run enemy-stats:data:check && npm run enemies:doc:check && npm run progress:check && npm run docs:check",
    "docs:check": "node scripts/docs-check.mjs",
    "progress": "node scripts/gen-progress.mjs",
    "progress:check": "node scripts/gen-progress.mjs --check",
    "cap:sync": "cap sync",
    "prepare": "node scripts/install-hooks.mjs",
    "smoke": "node scripts/smoke.mjs",
    "look": "node scripts/look.mjs",
    "sweep": "node scripts/sweep.mjs"
  },
  "dependencies": {
    "phaser": "^3.90.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.2.0",
    "@capacitor/core": "^7.2.0",
    "@eslint/js": "^9.28.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "eslint": "^9.28.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "knip": "^6.29.0",
    "playwright": "^1.62.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.0",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  }
}
