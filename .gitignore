# Root ignores. NewVersion/.gitignore covers the app subtree in more detail.

# Dependencies and build output
node_modules/
dist/
dist-ssr/
.vite/
coverage/
*.local

# Capacitor native projects (generated by `npx cap add`)
android/
ios/

# Generated reports
audio-audit.json

# Extracted SWF assets are copied into NewVersion/src/assets by
# `npm run assets:sync` from SWFimported/, which IS committed and is the source
# of truth. Committing the copies too would duplicate ~8 MB of binaries.
NewVersion/src/assets/images/
NewVersion/src/assets/audio/
NewVersion/src/assets/shapes/
NewVersion/src/assets/fonts/

# Claude Code machine-local settings (absolute paths, per-machine permissions).
# .claude/settings.json IS shared; only the .local override is personal.
.claude/settings.local.json

# Editor and OS noise
.DS_Store
Thumbs.db
*.log
npm-debug.log*
.idea/
.vscode/*
!.vscode/extensions.json
